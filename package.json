{
  "name": "asilbek-masturaxon-taklifnoma",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Asilbek va Masturaxonning milliy uslubdagi to‘y taklifnomasi",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:dates && npm run test:audio",
    "test:dates": "node --experimental-strip-types --no-warnings scripts/check-dates.ts",
    "test:audio": "node --import tsx scripts/check-audio.tsx"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
